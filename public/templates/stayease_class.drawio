metry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="uses IRoomRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="n21" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="uses IReservationRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="n21" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="uses IRoomRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="n20" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="uses IReservationRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="n20" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="uses IRoomRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="n23" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="uses IReservationRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="n23" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="uses IPaymentRepository" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n23" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n45" value="Concrete repositories realize specialized interfaces, which extend IGenericRepository&amp;lt;T&amp;gt; với đúng kiểu Room/Reservation/Payment, nên thực hiện generic contract qua kế thừa interface. Thuộc tính/method hiển thị dùng tên mặc định; đổi tên đồng bộ theo đề mới. Staff/Admin nằm ngoài use case chính; có thể bổ sung nếu cần. Không ép dùng aggregation khi đề chưa có whole–part độc lập phù hợp." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;fillColor=#fff8df;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="2380" width="1810" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>