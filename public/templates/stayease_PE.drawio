eometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m11" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#ffffff;fontSize=12;" vertex="1" connectable="0" parent="e10"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="m12" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#ffffff;fontSize=12;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0;entryX=0;entryY=1;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m14" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#ffffff;fontSize=12;" vertex="1" connectable="0" parent="e13"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="m15" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#ffffff;fontSize=12;" vertex="1" connectable="0" parent="e13"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;startArrow=diamond;startFill=1;endArrow=none;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m17" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#ffffff;fontSize=12;" vertex="1" connectable="0" parent="e16"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="m18" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;labelBackgroundColor=#ffffff;fontSize=12;" vertex="1" connectable="0" parent="e16"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="n19" value="Composition BẮT BUỘC theo đề: Payment không tồn tại độc lập với Reservation; thoi đặc ở Reservation. Mỗi Room có nhiều Reservation theo lịch sử, nhưng không có hai booking hiệu lực trùng ngày. Sau checkout: Reservation=Completed; Room=Cleaning. Reservation chỉ tạo sau deposit thành công nên luôn có ít nhất 1 Payment." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;fillColor=#fff8df;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1810" height="95" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;BookingController&lt;/b&gt;&lt;hr/&gt;- rooms: IRoomRepository&lt;br/&gt;- reservations: IReservationRepository&lt;br/&gt;- payments: PaymentService&lt;hr/&gt;+ submitBooking(customerId, roomId, start, end): Result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="990" width="400" height="230" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;BookingService&lt;/b&gt;&lt;hr/&gt;- rooms: IRoomRepository&lt;br/&gt;- reservations: IReservationRepository&lt;hr/&gt;+ checkAvailability(roomId, start, end): boolean&lt;br/&gt;+ createReservation(customerId, room, dates): Reservation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="510" y="990" width="430" height="230" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;PaymentService&lt;/b&gt;&lt;hr/&gt;- gateway: PaymentGateway&lt;hr/&gt;+ processDeposit(customerId, roomId, dates): PaymentResult&lt;br/&gt;+ settleBalance(reservationId, invoice): PaymentResult" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1010" y="990" width="420" height="230" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;CheckoutService&lt;/b&gt;&lt;hr/&gt;- rooms: IRoomRepository&lt;br/&gt;- reservations: IReservationRepository&lt;br/&gt;- payments: IPaymentRepository&lt;hr/&gt;+ evaluateInspection(report): Money&lt;br/&gt;+ generateFinalInvoice(id, fee): Invoice&lt;br/&gt;+ completeCheckout(id): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1490" y="990" width="350" height="250" as="geometry"/></mxCell><mxCell id="e24" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0;entryX=0;entryY=0;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="&lt;b&gt;«interface» IGenericRepository&amp;lt;T&amp;gt;&lt;/b&gt;&lt;hr/&gt;&lt;hr/&gt;+ getById(id: Long): T&lt;br/&gt;+ save(entity: T): T&lt;br/&gt;+ update(entity: T): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="1360" width="490" height="180" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;«interface» IRoomRepository&lt;/b&gt;&lt;hr/&gt;&lt;hr/&gt;+ isAvailable(roomId, start, end): boolean&lt;br/&gt;+ updateStatus(roomId, status): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="1680" width="500" height="180" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;«interface» IReservationRepository&lt;/b&gt;&lt;hr/&gt;&lt;hr/&gt;+ createWithDeposit(reservation, payment): Reservation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="1680" width="500" height="180" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;«interface» IPaymentRepository&lt;/b&gt;&lt;hr/&gt;&lt;hr/&gt;+ findByReservation(id): List&amp;lt;Payment&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1320" y="1680" width="500" height="180" as="geometry"/></mxCell><mxCell id="e29" value="extends &amp;lt;Room&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="n26" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="&lt;b&gt;RoomRepository&lt;/b&gt;&lt;hr/&gt;- database: Database&lt;hr/&gt;+ getById(id): Room&lt;br/&gt;+ save(entity): Room&lt;br/&gt;+ update(entity): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="100" y="2080" width="460" height="190" as="geometry"/></mxCell><mxCell id="e31" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endA