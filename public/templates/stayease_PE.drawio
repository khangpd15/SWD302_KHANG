<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="SWD Study PE" version="24.7.17"><diagram id="architecture" name="00 Layered Architecture"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="1250"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;StayEase · Layered Architecture&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;fillColor=#efecfc;strokeColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1240" height="50" as="geometry"/></mxCell><mxCell id="n2" value="Presentation&lt;br/&gt;StayEase BookingUI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="450" height="100" as="geometry"/></mxCell><mxCell id="n3" value="Application / Control&lt;br/&gt;BookingController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="450" height="100" as="geometry"/></mxCell><mxCell id="n4" value="Business Services&lt;br/&gt;BookingService / PaymentService / CheckoutService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="650" height="110" as="geometry"/></mxCell><mxCell id="n5" value="Data Access&lt;br/&gt;IRoomRepository / IReservationRepository / IPaymentRepository&lt;br/&gt;Concrete repositories implement IGenericRepository&amp;lt;T&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="750" width="690" height="130" as="geometry"/></mxCell><mxCell id="n6" value="Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;shape=cylinder;" vertex="1" parent="1"><mxGeometry x="420" y="1000" width="420" height="100" as="geometry"/></mxCell><mxCell id="e7" value="submitBooking(roomId, dates)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="delegate / orchestrate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="depend on interfaces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="read / persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Q2: direct repository calls via interfaces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="380"/><mxPoint x="150" y="810"/></Array></mxGeometry></mxCell><mxCell id="n12" value="Theo Q2, BookingController trực tiếp gọi RoomRepository, PaymentService, ReservationRepository. Giả định Controller thuộc tầng điều phối ứng dụng và truy cập repository qua interface (không phải UI gọi database). BookingService ở Q1 phụ thuộc các interface, độc lập database. Không thêm Microservices." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;fillColor=#fff8df;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1220" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="class" name="Q1 StayEase Class"><mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="2550"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;StayEase · Q1 Design-level Class Diagram (3.0 points)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;fillColor=#efecfc;strokeColor=none;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1840" height="50" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;User {abstract}&lt;/b&gt;&lt;hr/&gt;- id: Long&lt;br/&gt;- fullName: String&lt;br/&gt;- email: String&lt;hr/&gt;+ login(): boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="310" height="210" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Host&lt;/b&gt;&lt;hr/&gt;- hostCode: String&lt;hr/&gt;+ listRoom(): void&lt;br/&gt;+ inspectRoom(roomId): Report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="310" height="210" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Customer&lt;/b&gt;&lt;hr/&gt;&lt;hr/&gt;+ searchRooms(location, dates): List&amp;lt;Room&amp;gt;&lt;br/&gt;+ bookRoom(roomId, dates): Reservation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="340" height="210" as="geometry"/></mxCell><