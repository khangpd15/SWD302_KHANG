ry"><mxPoint x="500" y="2045" as="sourcePoint"/><mxPoint x="290" y="2045" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l46" value="display unavailable" style="html=1;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="2125" as="sourcePoint"/><mxPoint x="90" y="2125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n47" value="Thứ tự BẮT BUỘC của đề ảnh: check room → pay Deposit → SUCCESS mới create Reservation → save bằng ReservationRepository → Room=Booked. Payment Failure / Occupied: không tạo Reservation, không đổi Room thành Booked. Giả định PaymentService nhận receipt rồi lưu Deposit cùng Reservation trong một transaction (composition); cần timeout/refund/rollback ngoài phạm vi đề nếu lỗi lưu sau khi đã thu tiền." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6551ce;fontSize=14;spacing=10;fillColor=#fff8df;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="2320" width="2020" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>